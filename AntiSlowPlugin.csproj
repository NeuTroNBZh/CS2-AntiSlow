<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <AssemblyName>AntiSlowPlugin</AssemblyName>
    <RootNamespace>AntiSlowPlugin</RootNamespace>
    <Version>2.2.0</Version>
    <CopyLocalLockFileAssemblies>false</CopyLocalLockFileAssemblies>
    <!-- Release-ready layout: the build lands in addons/counterstrikesharp/plugins/AntiSlowPlugin/ -->
    <OutputPath>addons\counterstrikesharp\plugins\AntiSlowPlugin\</OutputPath>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <AppendRuntimeIdentifierToOutputPath>false</AppendRuntimeIdentifierToOutputPath>
  </PropertyGroup>

  <ItemGroup>
    <Compile Remove="AntiSlow.Core\**;tests\**" />
    <None Remove="AntiSlow.Core\**;tests\**" />
  </ItemGroup>

  <ItemGroup>
    <!-- Pinned: the server provides the runtime assembly; a floating version would change what each build compiles against. -->
    <PackageReference Include="CounterStrikeSharp.API" Version="1.0.370">
      <ExcludeAssets>runtime</ExcludeAssets>
    </PackageReference>
    <ProjectReference Include="AntiSlow.Core\AntiSlow.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Content Include="lang\**\*">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
  </ItemGroup>

</Project>
